        "fisher_batches": 32
      }
    },
    "train": {
      "epochs_per_task": 60,
      "batch_size": 128,
      "lr": 0.1,
      "momentum": 0.9,
      "weight_decay": 0.0005,
      "optimizer": "sgd",
      "loss_scope": "seen"
