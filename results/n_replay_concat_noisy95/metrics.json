{
  "config": {
    "run": {
      "name": "n_replay_concat_noisy95",
      "seed": 0,
      "output_dir": "results",
      "device": "auto"
    },
    "data": {
      "dataset": "cifar100",
      "num_tasks": 10,
      "classes_per_task": 10,
      "order_seed": 0,
      "data_root": "data",
      "num_workers": 4
    },
    "model": {
      "backbone": "resnet18_small",
      "feature_dim": 512
