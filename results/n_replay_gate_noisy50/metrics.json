      "trained": {
        "ckpt": "checkpoints/coarse_net.pt",
        "continual": false
      }
    },
    "conditioning": {
      "mechanism": "gate",
      "embed_dim": 32,
      "aux_loss_weight": 0.5,
      "decay_weight": 1.0,
      "eval_withhold": false
