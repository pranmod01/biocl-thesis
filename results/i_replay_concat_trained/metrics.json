      "lambda_max": 0.5,
      "schedule": "per_task",
      "tap": "layer2",
      "hidden": 128
    },
    "cl": {
      "methods": [
        "replay"
      ],
      "replay": {
        "buffer_size": 2000,
        "batch_size": 32,
        "weight": 1.0
      },
      "ewc": {
        "ewc_lambda": 5000.0,
        "fisher_batches": 32
      }
    },
    "train": {
      "epochs_per_task": 60,
      "batch_size": 128,
      "lr": 0.1,
      "momentum": 0.9,
      "weight_decay": 0.0005,
      "optimizer": "sgd",
      "loss_scope": "seen"
    },
    "coarse_train": {
      "epochs": 60,
      "batch_size": 128,
      "lr": 0.1,
      "momentum": 0.9,
