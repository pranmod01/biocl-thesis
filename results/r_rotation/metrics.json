        "smooth": 0.3
      },
      "trained": {
        "ckpt": "checkpoints/coarse_net.pt",
        "continual": false
      }
    },
    "conditioning": {
      "mechanism": "concat",
      "embed_dim": 32,
      "aux_loss_weight": 0.5,
      "decay_weight": 1.0,
      "eval_withhold": false
    },
    "rotation": {
      "enabled": true,
      "lambda_max": 0.5,
      "schedule": "per_task",
      "tap": "layer2",
      "hidden": 128
    },
    "train": {
      "epochs_per_task": 60,
      "batch_size": 128,
      "lr": 0.1,
      "momentum": 0.9,
      "weight_decay": 0.0005,
      "optimizer": "sgd",
      "loss_scope": "seen"
    },
